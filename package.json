{
  "name": "erascript-lang",
  "version": "0.1.0",
  "description": "EraScript — a TypeScript-compatible language focused on safer, clearer application and Web3 code.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "erascript": "./dist/src/cli.js",
    "era": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "node --enable-source-maps dist/src/cli.js"
  },
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3"
  }
}
