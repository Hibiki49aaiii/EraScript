{
  "name": "erascript-lang",
  "version": "0.10.0",
  "description": "EraScript — an AI-first, Node.js/TypeScript-compatible language for safer multi-chain Web3 automation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web3": {
      "types": "./dist/src/web3/index.d.ts",
      "import": "./dist/src/web3/index.js"
    },
    "./chains": {
      "types": "./dist/src/chains/index.d.ts",
      "import": "./dist/src/chains/index.js"
    },
    "./privacy": {
      "types": "./dist/src/privacy/index.d.ts",
      "import": "./dist/src/privacy/index.js"
    }
  },
  "bin": {
    "erascript": "./dist/src/cli.js",
    "era": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core",
    "dev": "node --enable-source-maps dist/src/cli.js",
    "test:core": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build && node --test dist/test/live/*.test.js"
  },
  "dependencies": {
    "typescript": "^5.9.2",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@mysten/sui": "2.27.1",
    "@solana/kit": "8.1.0",
    "@railgun-community/wallet": "10.9.0"
  }
}
