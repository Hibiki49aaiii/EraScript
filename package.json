{
  "name": "erascript-lang",
  "version": "0.19.0-rc.1",
  "description": "EraScript — an AI-first, Node.js/TypeScript-compatible language for safer multi-chain Web3 automation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web3": {
      "types": "./dist/src/web3/index.d.ts",
      "import": "./dist/src/web3/index.js"
    },
    "./chains": {
      "types": "./dist/src/chains/index.d.ts",
      "import": "./dist/src/chains/index.js"
    },
    "./privacy": {
      "types": "./dist/src/privacy/index.d.ts",
      "import": "./dist/src/privacy/index.js"
    },
    "./signing": {
      "types": "./dist/src/signing/index.d.ts",
      "import": "./dist/src/signing/index.js"
    }
  },
  "bin": {
    "erascript": "./dist/src/cli.js",
    "era": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/WHITEHAT_GUIDE.md",
    "docs/RELEASE.md",
    "docs/VERIFICATION_TRUST_MODEL.md",
    "docs/SIGNING_AUTHORITY.md",
    "examples/whitehat-offline.era",
    "examples/signing-authority-offline.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:package": "node scripts/build.mjs --package",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core",
    "dev": "node --enable-source-maps dist/src/cli.js",
    "test:core": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build && node --test dist/test/live/*.test.js",
    "test:package": "npm run build:package && node scripts/package-smoke.mjs",
    "audit:evidence": "node scripts/audit-evidence.mjs",
    "release:prepare": "npm run check && npm run test:core && node --test scripts/test/*.test.mjs && npm run test:package && node scripts/release-prepare.mjs",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "typescript": "^7.0.2",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@mysten/sui": "2.27.1",
    "@solana/kit": "8.1.0",
    "@railgun-community/wallet": "10.9.0"
  }
}
